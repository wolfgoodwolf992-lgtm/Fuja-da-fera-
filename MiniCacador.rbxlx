<roblox version="4"><Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string><Item class="Script"><Properties><string name="Name">MiniCacador_Server</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- MiniCaçador | servidor
-- Place completo: lobby, votação física, mapas e rodadas.
-- A captura é arcade e não gráfica: o caçador usa um marcador de energia, não uma faca realista.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local remotes = Instance.new("Folder")
remotes.Name = "GameRemotes"
remotes.Parent = ReplicatedStorage

local function remote(name)
    local r = Instance.new("RemoteEvent")
    r.Name = name
    r.Parent = remotes
    return r
end

local UIEvent = remote("UIEvent")
local TagRequest = remote("TagRequest")

local mapsFolder = Instance.new("Folder")
mapsFolder.Name = "Mapas"
mapsFolder.Parent = workspace

local lobbyFolder = Instance.new("Folder")
lobbyFolder.Name = "Lobby"
lobbyFolder.Parent = workspace

local currentMap
local roundActive = false
local hunter
local survivors = {}
local votes = {}
local voteParts = {}
local voteOpen = false
local roundNumber = 0

local COLORS = {
    office = Color3.fromRGB(70, 125, 165),
    playground = Color3.fromRGB(90, 165, 105),
    maze = Color3.fromRGB(145, 100, 175)
}

local function part(parent, name, size, cf, color, material)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cf
    p.Anchored = true
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function label(partObj, text)
    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.fromOffset(220, 60)
    gui.StudsOffset = Vector3.new(0, 3.3, 0)
    gui.AlwaysOnTop = true
    gui.Parent = partObj
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextColor3 = Color3.new(1,1,1)
    t.TextStrokeTransparency = 0.25
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.Parent = gui
end

local function makeLamp(parent, pos, color)
    local bulb = part(parent, "LuzDoLabirinto", Vector3.new(2, .35, 2),
        CFrame.new(pos), color, Enum.Material.Neon)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = 1.5
    light.Range = 24
    light.Parent = bulb
    return light
end

local function makeLobby()
    part(lobbyFolder, "PisoLobby", Vector3.new(100, 2, 100),
        CFrame.new(0, -1, 0), Color3.fromRGB(43, 52, 67), Enum.Material.Slate)
    part(lobbyFolder, "ParedeNorte", Vector3.new(100, 18, 2),
        CFrame.new(0, 8, -50), Color3.fromRGB(35, 42, 58))
    part(lobbyFolder, "ParedeSul", Vector3.new(100, 18, 2),
        CFrame.new(0, 8, 50), Color3.fromRGB(35, 42, 58))
    part(lobbyFolder, "ParedeLeste", Vector3.new(2, 18, 100),
        CFrame.new(50, 8, 0), Color3.fromRGB(35, 42, 58))
    part(lobbyFolder, "ParedeOeste", Vector3.new(2, 18, 100),
        CFrame.new(-50, 8, 0), Color3.fromRGB(35, 42, 58))

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "SpawnLobby"
    spawn.Size = Vector3.new(8, 1, 8)
    spawn.CFrame = CFrame.new(0, 1, 0)
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.Color = Color3.fromRGB(80, 190, 150)
    spawn.Parent = lobbyFolder

    local titlePart = part(lobbyFolder, "Titulo", Vector3.new(1,1,1),
        CFrame.new(0, 10, -35), Color3.new(1,1,1), Enum.Material.SmoothPlastic)
    titlePart.Transparency = 1
    titlePart.CanCollide = false
    label(titlePart, "MINICAÇADOR  •  VOTE NO MAPA")

    local positions = {
        {Vector3.new(-24, 1, 22), "ESCRITÓRIO", "Office"},
        {Vector3.new(0, 1, 22), "PLAYGROUND", "Playground"},
        {Vector3.new(24, 1, 22), "LABIRINTO", "Maze"}
    }
    for _, info in ipairs(positions) do
        local pad = part(lobbyFolder, "Voto_"..info[3], Vector3.new(13, 1, 13),
            CFrame.new(info[1]), COLORS[string.lower(info[3])] or Color3.fromRGB(100,100,130),
            Enum.Material.Neon)
        pad:SetAttribute("MapName", info[3])
        label(pad, info[2].."  •  0 votos")
        table.insert(voteParts, pad)
        pad.Touched:Connect(function(hit)
            if not voteOpen then return end
            local character = hit:FindFirstAncestorOfClass("Model")
            local plr = character and Players:GetPlayerFromCharacter(character)
            if plr then
                votes[plr.UserId] = info[3]
                updateVotes()
            end
        end)
    end
end

function updateVotes()
    for _, pad in ipairs(voteParts) do
        local mapName = pad:GetAttribute("MapName")
        local count = 0
        for _, choice in pairs(votes) do
            if choice == mapName then count += 1 end
        end
        local gui = pad:FindFirstChildOfClass("BillboardGui")
        if gui then
            gui.TextLabel.Text = string.upper(mapName).."  •  "..count.." votos"
        end
    end
end

local function buildMaze(parent, theme, baseColor)
    local floor = part(parent, "Chao", Vector3.new(120, 2, 120),
        CFrame.new(0, 0, 220), baseColor, Enum.Material.Slate)
    local wallColor = theme == "Office" and Color3.fromRGB(105, 125, 145)
        or theme == "Playground" and Color3.fromRGB(65, 135, 85)
        or Color3.fromRGB(115, 85, 145)
    local wallMat = theme == "Office" and Enum.Material.Concrete or Enum.Material.SmoothPlastic

    -- Paredes externas
    part(parent, "ParedeNorte", Vector3.new(120, 15, 3), CFrame.new(0, 8, 160), wallColor, wallMat)
    part(parent, "ParedeSul", Vector3.new(120, 15, 3), CFrame.new(0, 8, 280), wallColor, wallMat)
    part(parent, "ParedeLeste", Vector3.new(3, 15, 120), CFrame.new(60, 8, 220), wallColor, wallMat)
    part(parent, "ParedeOeste", Vector3.new(3, 15, 120), CFrame.new(-60, 8, 220), wallColor, wallMat)

    -- Corredores em grade, com aberturas alternadas para formar caminhos.
    for row = 1, 5 do
        local z = 160 + row * 18
        for col = 1, 5 do
            local x = -45 + col * 18
            if (row + col) % 3 ~= 0 then
                part(parent, "ParedeInterna", Vector3.new(3, 11, 15),
                    CFrame.new(x, 6.5, z), wallColor, wallMat)
            end
            if (row * col) % 4 ~= 0 then
                part(parent, "ParedeInterna", Vector3.new(15, 11, 3),
                    CFrame.new(x - 9, 6.5, z - 9), wallColor, wallMat)
            end
        end
    end

    -- Decoração temática e luminárias distribuídas pelo percurso.
    for i = 1, 8 do
        local x = -42 + (i % 4) * 28
        local z = 174 + math.floor((i-1)/4) * 54
        makeLamp(parent, Vector3.new(x, 13.5, z), Color3.fromRGB(255, 230, 160))
        if theme == "Office" then
            local desk = part(parent, "Mesa", Vector3.new(9, 1, 4),
                CFrame.new(x + 6, 2, z + 6), Color3.fromRGB(105, 70, 45), Enum.Material.Wood)
            part(parent, "Computador", Vector3.new(3, 2, .5),
                desk.CFrame * CFrame.new(0, 1.5, -1), Color3.fromRGB(35, 45, 60), Enum.Material.Metal)
        elseif theme == "Playground" then
            local post = part(parent, "Brinquedo", Vector3.new(2, 7, 2),
                CFrame.new(x + 6, 4, z + 6), Color3.fromRGB(240, 170, 55), Enum.Material.Neon)
            part(parent, "Plataforma", Vector3.new(8, 1, 8),
                post.CFrame * CFrame.new(0, -2, 0), Color3.fromRGB(65, 180, 210), Enum.Material.Neon)
        else
            part(parent, "CristalDecorativo", Vector3.new(3, 7, 3),
                CFrame.new(x + 6, 4, z + 6), Color3.fromRGB(190, 115, 255), Enum.Material.Neon)
        end
    end
    return CFrame.new(0, 5, 220), CFrame.new(-48, 5, 170)
end

local function createMap(name)
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = mapsFolder
    local color = COLORS[string.lower(name)] or Color3.fromRGB(100,100,130)
    local survivorSpawn, hunterSpawn = buildMaze(folder, name, color)
    return folder, survivorSpawn, hunterSpawn
end

local function sendAll(action, data)
    UIEvent:FireAllClients(action, data)
end

local function setAtmosphere(dark)
    if dark then
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.8
        Lighting.FogColor = Color3.fromRGB(8, 8, 15)
        Lighting.FogStart = 10
        Lighting.FogEnd = 115
        Lighting.Ambient = Color3.fromRGB(25, 25, 40)
        Lighting.OutdoorAmbient = Color3.fromRGB(12, 12, 20)
    else
        Lighting.ClockTime = 14
        Lighting.Brightness = 2
        Lighting.FogColor = Color3.fromRGB(190, 205, 220)
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
        Lighting.Ambient = Color3.fromRGB(120, 120, 120)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end
end

local function teleport(plr, cf)
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        plr.Character:PivotTo(cf + Vector3.new(math.random(-5,5), 0, math.random(-5,5)))
    end
end

local function aliveSurvivors()
    local count = 0
    for plr, alive in pairs(survivors) do
        if alive and plr.Parent == Players then count += 1 end
    end
    return count
end

local function giveTagger(plr)
    local tool = Instance.new("Tool")
    tool.Name = "Marcador de Energia"
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(.45, 2.5, .45)
    handle.Material = Enum.Material.Neon
    handle.Color = Color3.fromRGB(80, 225, 255)
    handle.Parent = tool
    local light = Instance.new("PointLight")
    light.Color = handle.Color
    light.Brightness = 2
    light.Range = 8
    light.Parent = handle
    tool.Parent = plr:WaitForChild("Backpack")
end

TagRequest.OnServerEvent:Connect(function(plr)
    if not roundActive or plr ~= hunter or not plr.Character then return end
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for target, alive in pairs(survivors) do
        if alive and target.Character then
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and hum and (targetRoot.Position - root.Position).Magnitude &lt;= 9 then
                survivors[target] = false
                target:SetAttribute("Eliminated", true)
                hum.WalkSpeed = 0
                sendAll("Notice", target.DisplayName.." foi capturado!")
                UIEvent:FireClient(target, "Eliminated")
                break
            end
        end
    end
end)

local function waitForPlayers()
    while #Players:GetPlayers() &lt; 2 do
        sendAll("Notice", "Aguardando pelo menos 2 jogadores...")
        task.wait(3)
    end
end

local function chooseMap()
    votes = {}
    voteOpen = true
    updateVotes()
    sendAll("Vote", 15)
    for i = 15, 1, -1 do
        sendAll("Countdown", "Votação: "..i)
        task.wait(1)
    end
    voteOpen = false
    local counts = {Office=0, Playground=0, Maze=0}
    for _, choice in pairs(votes) do counts[choice] = (counts[choice] or 0) + 1 end
    local highest = math.max(counts.Office, counts.Playground, counts.Maze)
    local choices = {}
    for name, count in pairs(counts) do
        if count == highest then table.insert(choices, name) end
    end
    return choices[math.random(1, #choices)]
end

local function runRound()
    waitForPlayers()
    roundNumber += 1
    local mapName = chooseMap()
    if currentMap then currentMap:Destroy() end
    local map, survivorSpawn, hunterSpawn = createMap(mapName)
    currentMap = map
    setAtmosphere(true)

    local roster = Players:GetPlayers()
    hunter = roster[math.random(1, #roster)]
    survivors = {}
    for _, plr in ipairs(roster) do
        if plr.Character then
            if plr == hunter then
                teleport(plr, hunterSpawn)
            else
                survivors[plr] = true
                plr:SetAttribute("Eliminated", false)
                teleport(plr, survivorSpawn)
            end
        end
    end

    roundActive = true
    UIEvent:FireAllClients("RoundStart", {hunterName = hunter.DisplayName, mapName = mapName})
    UIEvent:FireClient(hunter, "HunterWait", 15)
    for i = 15, 1, -1 do
        UIEvent:FireClient(hunter, "Countdown", "Você será liberado em "..i)
        task.wait(1)
    end
    if hunter and hunter.Parent == Players then giveTagger(hunter) end
    UIEvent:FireAllClients("HunterReleased")
    local elapsed = 0
    while roundActive and elapsed &lt; 180 and aliveSurvivors() &gt; 0 do
        task.wait(1)
        elapsed += 1
    end
    roundActive = false
    if aliveSurvivors() == 0 then
        sendAll("Notice", "O caçador venceu!")
    else
        sendAll("Notice", "Sobreviventes venceram!")
    end
    task.wait(5)
    setAtmosphere(false)
    if currentMap then currentMap:Destroy() currentMap = nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        plr:SetAttribute("Eliminated", false)
        if plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
            teleport(plr, CFrame.new(0, 4, 0))
        end
    end
    hunter = nil
    survivors = {}
end

makeLobby()
setAtmosphere(false)

Players.PlayerAdded:Connect(function(plr)
    plr:SetAttribute("Eliminated", false)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if not roundActive then teleport(plr, CFrame.new(0, 4, 0)) end
    end)
end)

task.spawn(function()
    while true do
        task.wait(2)
        if not roundActive then
            local ok, err = pcall(runRound)
            if not ok then warn("Erro na rodada: "..tostring(err)) roundActive = false setAtmosphere(false) end
            task.wait(4)
        end
    end
end)
