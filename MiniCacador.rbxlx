local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("GameRemotes")
local UIEvent = remotes:WaitForChild("UIEvent")
local TagRequest = remotes:WaitForChild("TagRequest")

local gui = Instance.new("ScreenGui")
gui.Name = "MiniCacadorUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function textLabel(name, size, pos, text, fontSize)
    local t = Instance.new("TextLabel")
    t.Name = name
    t.Size = size
    t.Position = pos
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextColor3 = Color3.new(1,1,1)
    t.TextStrokeColor3 = Color3.new(0,0,0)
    t.TextStrokeTransparency = 0.15
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.Parent = gui
    return t
end

local status = textLabel("Status", UDim2.fromOffset(310, 42), UDim2.new(1,-325,0,12), "No lobby", 20)
status.TextXAlignment = Enum.TextXAlignment.Right
local role = textLabel("Role", UDim2.fromOffset(310, 34), UDim2.new(1,-325,0,56), "", 18)
role.TextXAlignment = Enum.TextXAlignment.Right

-- Roleta horizontal, sem caixa de fundo.
local roulette = Instance.new("Frame")
roulette.Name = "RoletaHorizontal"
roulette.Size = UDim2.new(.72, 0, 0, 62)
roulette.Position = UDim2.new(.14, 0, .36, 0)
roulette.BackgroundTransparency = 1
roulette.Visible = false
roulette.ClipsDescendants = true
roulette.Parent = gui

local strip = Instance.new("Frame")
strip.BackgroundTransparency = 1
strip.Size = UDim2.new(0, 3000, 1, 0)
strip.Parent = roulette
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 18)
layout.Parent = strip

local reveal = textLabel("Escolhido", UDim2.new(.72,0,0,62), UDim2.new(.14,0,.47,0), "", 28)
reveal.Visible = false

local creepy = Instance.new("Sound")
creepy.Name = "MusicaDeTensao"
creepy.SoundId = "rbxassetid://0" -- Troque por um áudio seu/publicado no Roblox.
creepy.Looped = true
creepy.Volume = .45
creepy.Parent = gui

local tick = Instance.new("Sound")
tick.Name = "SomDaRoleta"
tick.SoundId = "rbxassetid://0" -- Troque por um áudio curto seu/publicado no Roblox.
tick.Volume = .6
tick.Parent = gui

local flicker = false
local function startFlicker()
    if flicker then return end
    flicker = true
    task.spawn(function()
        while flicker do
            Lighting.Brightness = math.random(35, 100)/100
            local maps = workspace:FindFirstChild("Mapas")
            if maps then
                for _, obj in ipairs(maps:GetDescendants()) do
                    if obj:IsA("PointLight") then
                        obj.Enabled = (math.random() &gt; .28)
                        obj.Brightness = math.random(3, 18)/10
                    end
                end
            end
            task.wait(math.random(8,22)/100)
        end
        Lighting.Brightness = .8
        local maps = workspace:FindFirstChild("Mapas")
        if maps then
            for _, obj in ipairs(maps:GetDescendants()) do
                if obj:IsA("PointLight") then
                    obj.Enabled = true
                    obj.Brightness = 1.5
                end
            end
        end
    end)
end

local function stopFlicker()
    flicker = false
    Lighting.Brightness = .8
end

local function playRoulette(names, winner)
    roulette.Visible = true
    reveal.Visible = false
    for _, child in ipairs(strip:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local sequence = {}
    for i = 1, 8 do
        for _, n in ipairs(names) do table.insert(sequence, n) end
    end
    table.insert(sequence, winner)
    for i, n in ipairs(sequence) do
        local item = Instance.new("TextLabel")
        item.BackgroundTransparency = 1
        item.Size = UDim2.fromOffset(190, 58)
        item.Text = "&gt; "..n.." &lt;"
        item.TextColor3 = Color3.fromRGB(245,245,255)
        item.TextStrokeTransparency = .1
        item.Font = Enum.Font.GothamBold
        item.TextScaled = true
        item.LayoutOrder = i
        item.Parent = strip
    end
    strip.Position = UDim2.new(0,0,0,0)
    local itemWidth = 208
    local targetX = -((#sequence-1)*itemWidth) + roulette.AbsoluteSize.X/2 - 95
    local duration = math.max(4, #sequence * .12)
    local tween = TweenService:Create(strip, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Position = UDim2.new(0,targetX,0,0)})
    tween:Play()
    local started = os.clock()
    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if os.clock() - started &gt; .22 then tick:Play() started = os.clock() end
        task.wait(.04)
    end
    roulette.Visible = false
    -- Revelação em dois quadros: nome e destaque separados, mesma dimensão.
    reveal.Text = "&gt; "..winner.." &lt;"
    reveal.Visible = true
    reveal.TextColor3 = Color3.fromRGB(255,255,255)
    task.wait(.18)
    reveal.TextColor3 = Color3.fromRGB(255,90,90)
    task.wait(.18)
    reveal.TextColor3 = Color3.fromRGB(255,255,255)
    task.wait(2.2)
    reveal.Visible = false
end

UIEvent.OnClientEvent:Connect(function(action, data)
    if action == "Notice" then
        status.Text = tostring(data)
        task.delay(3, function() if status.Text == tostring(data) then status.Text = "" end end)
    elseif action == "Countdown" then
        status.Text = tostring(data)
    elseif action == "Vote" then
        status.Text = "Pise em uma plataforma para votar!"
    elseif action == "RoundStart" then
        status.Text = "Mapa: "..tostring(data.mapName)
        role.Text = "Sorteando o caçador..."
        local names = {}
        for _, p in ipairs(Players:GetPlayers()) do table.insert(names, p.DisplayName) end
        task.spawn(playRoulette, names, data.hunterName)
        task.wait(.1)
        if data.hunterName == player.DisplayName then
            role.Text = "VOCÊ É O CAÇADOR"
        else
            role.Text = "Fuja e encontre um caminho!"
        end
    elseif action == "HunterWait" then
        role.Text = "Aguarde antes de sair..."
    elseif action == "HunterReleased" then
        role.Text = "O caçador foi liberado!"
    elseif action == "Eliminated" then
        role.Text = "Você foi capturado nesta rodada."
    end
end)

-- A música de tensão e o pisca-pisca são ativados quando o caçador se aproxima.
task.spawn(function()
    while true do
        task.wait(.35)
        local hunterPlayer
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChildOfClass("Tool") then
                if p.Character:FindFirstChildOfClass("Tool").Name == "Marcador de Energia" then
                    hunterPlayer = p
                    break
                end
            end
        end
        local close = false
        if hunterPlayer and player.Character and hunterPlayer.Character then
            local a = player.Character:FindFirstChild("HumanoidRootPart")
            local b = hunterPlayer.Character:FindFirstChild("HumanoidRootPart")
            if a and b and (a.Position-b.Position).Magnitude &lt; 35 then close = true end
        end
        if close then
            if not creepy.IsPlaying then creepy:Play() end
            startFlicker()
        else
            if creepy.IsPlaying then creepy:Stop() end
            stopFlicker()
        end
    end
end)

-- Clique/toque solicita uma captura arcade; o servidor valida a distância.
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.Touch then
        local char = player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and tool.Name == "Marcador de Energia" then
            TagRequest:FireServer()
        end
    end
end)
